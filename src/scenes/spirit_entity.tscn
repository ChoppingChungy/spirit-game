[gd_scene format=3 uid="uid://co8xkftb3bsll"]

[sub_resource type="GDScript" id="GDScript_t2nh6"]
resource_name = "spirit_entity"
script/source = "extends Node2D
signal wet
@onready var sprite_2d: Sprite2D = $Sprite2D

@onready var collision_shape_2d: CollisionShape2D = $Sprite2D/Area2D/CollisionShape2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass






var velocity = Vector2(750, 750)

func _process(delta):
	position += velocity * delta

	var screen_size = get_viewport_rect().size

	if position.x <= 0:
		position.x = 0
		velocity.x = abs(velocity.x)

	elif position.x >= screen_size.x:
		position.x = screen_size.x
		velocity.x = -abs(velocity.x)

	if position.y <= 0:
		position.y = 0
		velocity.y = abs(velocity.y)

	elif position.y >= screen_size.y:
		position.y = screen_size.y
		velocity.y = -abs(velocity.y)


func _on_area_2d_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"watergun\"):
		print(\"ooh\")
		emit_signal(\"wet\")


func _on_area_2d_area_exited(area: Area2D) -> void:
	if area.is_in_group(\"watergun\"):
		
		emit_signal(\"wet\")
"

[node name="SpiritEntity" type="Node2D" unique_id=355366846]
script = SubResource("GDScript_t2nh6")
