[gd_scene format=3 uid="uid://rfsqo1g5h5jc"]

[sub_resource type="GDScript" id="GDScript_5omm6"]
script/source = "extends Node2D
@onready var hit_box: Area2D = $HitBox
@onready var muzzle: Marker2D = $Muzzle
@onready var stream: Line2D = $Stream

func update_water(mouse: Vector2):
	var start = muzzle.global_position
	var end = mouse
	var point_count = 20

	var direction = (end - start).normalized()
	var perpendicular = Vector2(-direction.y, direction.x)

	var distance = start.distance_to(end)
	var arc_strength = distance * 0.08

	stream.clear_points()

	for i in range(point_count):
		var t = float(i) / float(point_count - 1)
		var point = start.lerp(end, t)

		# Arc
		var arc = sin(t * PI)
		point.y -= arc * arc_strength

		# Small water oscillation
		var time = Time.get_ticks_msec() * 0.012
		var wave = (
			sin(t * 20.0 + time) * 4.0
			+ sin(t * 37.0 - time * 1.4) * 2.0
		)

		point += perpendicular * wave * t

		stream.add_point(
			stream.to_local(point)
		)
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	var mouse = get_global_mouse_position()
	hit_box.global_position = mouse
	update_water(mouse)
		


	
"

